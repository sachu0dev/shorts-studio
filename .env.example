# Copy to .env and fill in the keys for whichever AI providers you want to use.
# At least ONE provider must be configured.

# ── Anthropic (Claude) ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── OpenAI (GPT-4o) ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── Google Gemini ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-flash-latest

# ── Giphy (memes/GIFs) ──────────────────────────────────────────────────────────
GIPHY_API_KEY=

# ── Storage & Server ────────────────────────────────────────────────────────────
# Where downloads/outputs live (default ./storage)
STORAGE_DIR=./storage
PORT=5177
