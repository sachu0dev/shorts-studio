# Copy to .env and fill in the keys for whichever AI providers you want to use.
# At least ONE provider must be configured.

# ── Anthropic (Claude) ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── OpenAI (GPT-4o) ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── Google Gemini ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-flash-latest

# ── Ollama (Local LLM - Qwen 2.5 7B) ───────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# ── Giphy (memes/GIFs) ──────────────────────────────────────────────────────────
GIPHY_API_KEY=

# ── Google Fonts (caption fonts, cached locally after first use) ────────────────
GOOGLE_FONTS_API_KEY=

# ── Python media worker (phase 0) ───────────────────────────────────────────────
# Must be a 3.12 venv with CUDA torch. System python (3.14) has no torch wheels.
#   uv venv --python 3.12 worker/.venv
WORKER_PYTHON=./worker/.venv/bin/python

# Hugging Face token — pyannote 3.1 (bundled in WhisperX) is a gated model.
# Accept the terms at hf.co/pyannote/speaker-diarization-3.1 first. Needed from phase 2.
HF_TOKEN=

# ── Storage & Server ────────────────────────────────────────────────────────────
# Where downloads/outputs live (default ./storage)
STORAGE_DIR=./storage
PORT=5177

# Camera feel for fullscreen-follow: calm (default) or dynamic.
COMPOSITION_PRESET=calm
